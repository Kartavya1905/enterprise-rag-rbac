# Copy to .env and adjust. Never commit .env.

APP_NAME="Enterprise RAG (RBAC)"
# dev | test | prod  (prod refuses to start with the default JWT secret)
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Relational DB (users, roles, document registry, audit log) ---
# Leave unset for local dev: defaults to SQLite at data/dev.db.
# For Postgres (docker compose up postgres):
# DATABASE_URL=postgresql+psycopg://rag:rag_dev_password@localhost:5432/enterprise_rag

# --- Vector DB ---
# Leave QDRANT_URL unset to use embedded Qdrant stored under data/qdrant (no server needed).
# For the Qdrant server (docker compose up qdrant):
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_docs

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Prod refuses to start unless this is at least 32 characters and not "change-me".
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=60
# bcrypt cost factor (4-16). Higher = slower to brute-force, slower to log in.
PASSWORD_HASH_ROUNDS=12

# --- Web UI demo (Phase 10) ---
# DEV ONLY: one-click persona switcher with NO password. Never enable on a shared server;
# the app refuses to start with it on when ENVIRONMENT=prod.
DEMO_LOGIN=false

# --- LLM (local Ollama: free, no API key) ---
# Native Ollama on Windows or `docker compose --profile llm up ollama` both listen here.
OLLAMA_BASE_URL=http://localhost:11434
# Pull once with: docker compose exec ollama ollama pull qwen2.5:7b
# No NVIDIA GPU? Use the smaller, faster (but weaker) llama3.2:3b instead.
LLM_MODEL=qwen2.5:7b
