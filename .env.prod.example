# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored).
# Generate EACH secret separately with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (URL-safe characters only: the Postgres password goes inside a connection URL.)

POSTGRES_PASSWORD=
QDRANT_API_KEY=
JWT_SECRET_KEY=

# ENVIRONMENT=prod and DEMO_LOGIN=false are forced by docker-compose.prod.yml.
LOG_LEVEL=INFO
JWT_EXPIRE_MINUTES=60
PASSWORD_HASH_ROUNDS=12

# Local LLM. qwen2.5:7b needs a GPU with ~8 GB; llama3.2:3b runs on CPU.
LLM_MODEL=qwen2.5:7b
# How long Ollama keeps the model in GPU memory after a question. Longer = no ~35 s
# cold start, but ~5.6 GB of GPU memory stays in use. "-1" = forever.
OLLAMA_KEEP_ALIVE=30m
